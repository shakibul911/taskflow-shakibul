# Task-Flow Backend Environment Configuration

# MySQL Connection Details
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_flow_db

# Complete Database URL (Defaults to MySQL PyMySQL connection)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/task_flow_db

# Set to true to run directly with SQLite (no MySQL setup required)
USE_SQLITE=false

# Server Configuration
PORT=8000
HOST=0.0.0.0

