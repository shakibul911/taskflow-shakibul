# Task-Flow Monorepo Environment Variables Reference

# Backend Settings (see backend/.env.example)
DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_flow_db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/task_flow_db
USE_SQLITE=false
PORT=8000
HOST=0.0.0.0

# Frontend Settings (see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8000/api

